# =============================================================================
# .dockerignore — safliix-dash (Next.js 15)
# Exclut tout ce qui n'est pas necessaire au build Docker
# Aligne sur sachrist (gold standard)
# =============================================================================

# Git
.git
.gitignore

# Dependencies (reinstallees dans le container)
node_modules

# Next.js build output (reconstruit dans le container)
.next
out
build

# Tests
coverage
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Infrastructure (pas besoin dans l'image)
infra/deployment
infra/environments
infra/quality
infra/templates
# Note: infra/docker/ est NECESSAIRE (Dockerfile + entrypoint.sh si present)

# CI/CD
.github

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env files (secrets)
.env
.env.local
.env.*.local
.env.secrets

# Documentation
README.md
CLAUDE.md
*.md

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
*.pem
.vercel
*.tsbuildinfo
next-env.d.ts
bug/
endpoint-needs.txt
report-api-needs.txt
*.pdf
