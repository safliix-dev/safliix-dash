# =============================================================================
# .env.prod — safliix-dash production environment
# =============================================================================
# Ce fichier contient la CONFIGURATION, pas les secrets
# Les secrets sont dans .env.secrets (non versionne, cree manuellement sur svr-front)
#
# Architecture PROD :
#   svr-front : safliix-dash (Next.js admin dashboard) → dashboard.safliix.com
#   svr-back  : adminApp (NestJS API) → dashboard-api.safliix.com
# =============================================================================

# Environment
NODE_ENV=production
ENV=prod
DEBUG=false
LOG_LEVEL=error

# Harbor PROD
IMAGE_TAG=latest
PULL_POLICY=IfNotPresent

# Container & Ports
CONTAINER_NAME=safliix-dash-prod
HOST_PORT=3002

# Reseau PRODUCTION
NETWORK_NAME=safliix-prod-network
NETWORK_EXTERNAL_NAME=safliix-prod-common-network

# Health check plus robuste en production
HEALTH_INTERVAL=30s
HEALTH_TIMEOUT=10s
HEALTH_RETRIES=3
HEALTH_START_PERIOD=30s

# Domain & NextAuth
NEXTAUTH_URL=https://dashboard.safliix.com

# API Backend (adminApp sur svr-back)
NEXT_PUBLIC_API_URL=https://dashboard-api.safliix.com

# Keycloak (realm admin — operateurs et administrateurs)
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.safliix.com
NEXT_PUBLIC_KEYCLOAK_REALM=safliix-admin
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=safliix-dashboard
# Server-side NextAuth provider (meme client, mais sans prefix NEXT_PUBLIC_)
KEYCLOAK_CLIENT_ID=safliix-dashboard
KEYCLOAK_ISSUER=https://auth.safliix.com/realms/safliix-admin

# Monitoring PROD
ENABLE_METRICS=true

# Securite PROD
ENABLE_SECURITY_HEADERS=true
FORCE_HTTPS=true

# =============================================================================
# === SECRETS (dans .env.secrets) ===
# =============================================================================
# NEXTAUTH_SECRET        → dans .env.secrets
# KEYCLOAK_CLIENT_SECRET → dans .env.secrets
