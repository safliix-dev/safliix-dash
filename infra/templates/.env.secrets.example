# ============================================================
# .env.secrets — SECRETS APPLICATIFS (NON VERSIONNE)
# ============================================================
# Copier ce fichier vers .env.secrets sur le serveur
# Ce fichier N'EST JAMAIS ecrase par deploy.sh
# ============================================================
# PROD: /srv/safliix-shared-project/safliix-dash/.env.secrets
# ============================================================

# ===================================================================
# === NEXTAUTH (NextAuth.js + Keycloak provider) ===
# ===================================================================
# Generer avec: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET

# ===================================================================
# === KEYCLOAK (realm safliix-admin, client safliix-dashboard) ===
# ===================================================================
# Recuperer dans Keycloak Admin > realm safliix-admin > Clients > safliix-dashboard > Credentials
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_KEYCLOAK_CLIENT_SECRET

# ===================================================================
# === DOCKER / HARBOR ===
# ===================================================================
DOCKER_USERNAME=robot$ops-infra-bot
DOCKER_PASSWORD=CHANGE_ME_HARBOR_ROBOT_TOKEN
